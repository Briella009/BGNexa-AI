# Optional. BGNexa works in evidence-retrieval/manual-review mode without an API key.
# Generation provider: auto (default), groq, or openai.
AI_PROVIDER=auto

# Free-tier-friendly generation option. Semantic embeddings remain local lexical fallback when only Groq is configured.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI generation + embeddings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
